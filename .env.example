APP_NAME="RHU LabChain"
ENVIRONMENT=production
NODE_ID=node-1
NODE_NAME="RHU LabChain Node 1"
NODE_PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rhu_labchain
DB_USER=rhu_app
DB_PASSWORD=replace_with_your_database_password

AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_COOKIE_NAME=rhu_session
AUTH_CSRF_COOKIE_NAME=rhu_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict

REPORT_STORAGE_DIR=/var/lib/rhu-labchain/reports
PUBLIC_BASE_URL=https://labchain.online
# Optional, administrator-managed PNG/JPEG signatures; paths in profiles are relative.
# REPORT_SIGNATURE_DIR=/var/lib/rhu-labchain/signatures

PATIENT_ACTIVATION_TTL_MINUTES=30

# Required: generate with python -m app.cli.generate_mfa_key; never commit the real key.
MFA_SECRET_ENCRYPTION_KEY=U7bbZU5jUc_LgSWwsgrBI-yude2y3rqJKO2z8LUni04=
MFA_TOTP_ISSUER=RHU LabChain
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_CHALLENGE_ATTEMPTS=5
MFA_TOTP_VALID_WINDOW=1
MFA_RECOVERY_CODE_COUNT=8
MFA_CHALLENGE_COOKIE_NAME=rhu_mfa_challenge
PATIENT_MFA_REQUIRED=true

# Phase 8B forward-only outbox capture.
BLOCKCHAIN_SOURCE_NODE=node1
BLOCKCHAIN_SOURCE_MSP=Org1MSP

# Phase 8B-3 setting definitions; production worker uses deploy/blockchain-worker.env.example.
# The dedicated worker never reads this web application dotenv file.
# The web application does not require these credentials. Paths only; never PEM.
BLOCKCHAIN_DELIVERY_ENABLED=false
BLOCKCHAIN_GATEWAY_ENDPOINT=127.0.0.1:7051
# BLOCKCHAIN_GATEWAY_TLS_CA_PATH=/opt/rhu-labchain/blockchain/network/runtime/single-vps/public/org1-tls-ca.crt
BLOCKCHAIN_CLIENT_MSP_ID=Org1MSP
# BLOCKCHAIN_CLIENT_CERT_PATH=/opt/rhu-labchain/blockchain/network/runtime/app-client-single-vps/org1/msp/signcerts/User1@org1.labchain.internal-cert.pem
# BLOCKCHAIN_CLIENT_KEY_PATH=/opt/rhu-labchain/blockchain/network/runtime/app-client-single-vps/org1/msp/keystore/REPLACE_WITH_ACTUAL_KEY_FILENAME
BLOCKCHAIN_CHANNEL=labchain-channel
BLOCKCHAIN_CHAINCODE=labchain-anchor
BLOCKCHAIN_ADAPTER_COMMAND='["/usr/bin/node","/opt/rhu-labchain/blockchain/gateway-adapter/src/cli.js"]'
BLOCKCHAIN_WORKER_POLL_SECONDS=2
BLOCKCHAIN_WORKER_BATCH_SIZE=1
BLOCKCHAIN_WORKER_MAX_ATTEMPTS=8
BLOCKCHAIN_WORKER_RETRY_BASE_SECONDS=15
BLOCKCHAIN_WORKER_RETRY_MAX_SECONDS=900
BLOCKCHAIN_WORKER_LEASE_SECONDS=120
BLOCKCHAIN_ADAPTER_TIMEOUT_SECONDS=90
