APP_NAME="RHU LabChain"
ENVIRONMENT=production
NODE_ID=node-1
NODE_NAME="RHU LabChain Node 1"
NODE_PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rhu_labchain
DB_USER=rhu_app
DB_PASSWORD=replace_with_your_database_password

AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_COOKIE_NAME=rhu_session
AUTH_CSRF_COOKIE_NAME=rhu_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict

REPORT_STORAGE_DIR=/var/lib/rhu-labchain/reports
PUBLIC_BASE_URL=https://labchain.online
# Optional, administrator-managed PNG/JPEG signatures; paths in profiles are relative.
# REPORT_SIGNATURE_DIR=/var/lib/rhu-labchain/signatures

PATIENT_ACTIVATION_TTL_MINUTES=30

# Required: generate with python -m app.cli.generate_mfa_key; never commit the real key.
MFA_SECRET_ENCRYPTION_KEY=U7bbZU5jUc_LgSWwsgrBI-yude2y3rqJKO2z8LUni04=
MFA_TOTP_ISSUER=RHU LabChain
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_CHALLENGE_ATTEMPTS=5
MFA_TOTP_VALID_WINDOW=1
MFA_RECOVERY_CODE_COUNT=8
MFA_CHALLENGE_COOKIE_NAME=rhu_mfa_challenge
PATIENT_MFA_REQUIRED=true
