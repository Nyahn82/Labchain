# Dedicated non-admin OU=client Org1 identity; never use peer/orderer/admin keys.
# Private key owner must be rhu-labchain-monitor, mode 0600 in a 0700 directory.
# Preserve signcerts/../cacerts layout required by the existing credential validator.
BLOCKCHAIN_CLIENT_CERT_PATH=/etc/rhu-labchain/monitor-identity/msp/signcerts/client.crt
BLOCKCHAIN_CLIENT_KEY_PATH=/etc/rhu-labchain/monitor-identity/msp/keystore/client.key
BLOCKCHAIN_GATEWAY_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/peer1-ca.crt
MONITOR_PEER1_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/peer1-ca.crt
MONITOR_PEER2_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/peer2-ca.crt
MONITOR_PEER3_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/peer3-ca.crt
MONITOR_PEER4_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/peer4-ca.crt
MONITOR_ORDERER_TLS_CA_PATH=/etc/rhu-labchain/monitor-identity/tls/orderer-ca.crt
# No DB credentials. No Docker access. No private key values in environment.
