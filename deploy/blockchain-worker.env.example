# TEMPLATE ONLY. Do not put real credentials in this tracked file.
# Operator creates /etc/rhu-labchain/blockchain-worker.env separately:
# root:rhu-labchain-worker, mode 0640; containing directory root-owned 0750.
# Parsed by systemd EnvironmentFile (not a shell; no variable expansion).
# This worker does not read /opt/rhu-labchain/.env or need MFA/auth secrets.
BLOCKCHAIN_DELIVERY_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rhu_labchain
DB_USER=REPLACE_WITH_APPROVED_DB_USER
DB_PASSWORD=REPLACE_WITH_REAL_DB_PASSWORD_OUTSIDE_GIT
BLOCKCHAIN_GATEWAY_ENDPOINT=127.0.0.1:7051
BLOCKCHAIN_GATEWAY_TLS_CA_PATH=/var/lib/rhu-labchain/blockchain-worker/tls/peer1-ca.crt
BLOCKCHAIN_CLIENT_MSP_ID=Org1MSP
BLOCKCHAIN_CLIENT_CERT_PATH=/var/lib/rhu-labchain/blockchain-worker/fabric-client/org1/msp/signcerts/client-cert.pem
BLOCKCHAIN_CLIENT_KEY_PATH=/var/lib/rhu-labchain/blockchain-worker/fabric-client/org1/msp/keystore/client-key.pem
BLOCKCHAIN_CHANNEL=labchain-channel
BLOCKCHAIN_CHAINCODE=labchain-anchor
BLOCKCHAIN_SOURCE_NODE=node1
BLOCKCHAIN_SOURCE_MSP=Org1MSP
BLOCKCHAIN_ADAPTER_COMMAND='["/usr/bin/node","/opt/rhu-labchain/blockchain/gateway-adapter/src/cli.js"]'
BLOCKCHAIN_WORKER_POLL_SECONDS=2
BLOCKCHAIN_WORKER_BATCH_SIZE=1
BLOCKCHAIN_WORKER_MAX_ATTEMPTS=8
BLOCKCHAIN_WORKER_RETRY_BASE_SECONDS=15
BLOCKCHAIN_WORKER_RETRY_MAX_SECONDS=900
BLOCKCHAIN_WORKER_LEASE_SECONDS=120
BLOCKCHAIN_ADAPTER_TIMEOUT_SECONDS=90
