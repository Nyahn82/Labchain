# Passed by the caller; the adapter does not source .env files.
BLOCKCHAIN_GATEWAY_ENDPOINT=127.0.0.1:7051
BLOCKCHAIN_GATEWAY_TLS_CA_PATH=/absolute/path/to/runtime/single-vps/public/org1-tls-ca.crt
BLOCKCHAIN_CLIENT_MSP_ID=Org1MSP
BLOCKCHAIN_CLIENT_CERT_PATH=/absolute/path/to/runtime/app-client-single-vps/org1/msp/signcerts/client-cert.pem
BLOCKCHAIN_CLIENT_KEY_PATH=/absolute/path/to/runtime/app-client-single-vps/org1/msp/keystore/client_sk
BLOCKCHAIN_CHANNEL=labchain-channel
BLOCKCHAIN_CHAINCODE=labchain-anchor
BLOCKCHAIN_SOURCE_NODE=node1
BLOCKCHAIN_READY_TIMEOUT_MS=5000
BLOCKCHAIN_EVALUATE_TIMEOUT_MS=10000
BLOCKCHAIN_ENDORSE_TIMEOUT_MS=30000
BLOCKCHAIN_SUBMIT_TIMEOUT_MS=10000
BLOCKCHAIN_COMMIT_TIMEOUT_MS=30000
